# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# build artifacts
data/ocr/
data/bank/
data/app.db*
data/*.log
data/*.out
pipeline/_probe/
/data/banks/
/pipeline/_audit/
/public/assets/
/data/*.sh
/data/__pycache__/
pipeline/__pycache__/
 
# isolated prod-build dir & python tooling caches 
.next-prod/ 
.pytest_cache/
 
# scratch & local data — never publish 
data/
